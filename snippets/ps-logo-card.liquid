{% comment %}
  PS Logo Card — reusable snippet
  Parameters:
    prefix       — unique id prefix e.g. 'jacket', 'hoodie', 'top', etc.
    position_id  — id for the position select e.g. 'jacket_ps_logo_position'
    position_holder_class — class for the position holder div e.g. 'jacket_ps_logo_position_holder'
    already_yes  — pass 'yes' if the logo was already selected (pre-check Yes radio)
{% endcomment %}

<style>
.ps-logo-card {
  position: relative;
  margin-top: 18px;
  border: 2px solid #8ec640;
  border-radius: 14px;
  background: linear-gradient(180deg, #ffffff 0%, #f0f8e3 100%);
  padding: 18px 18px 14px;
  box-shadow: 0 2px 14px rgba(11,93,59,0.10);
  overflow: hidden;
}
.ps-logo-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, #8ec640, #101820);
}
.ps-logo-card .ps-ribbon {
  position: absolute;
  top: 14px; right: -2px;
  background: #101820;
  color: #fff;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.3px;
  padding: 6px 14px 6px 18px;
  border-radius: 20px 0 0 20px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.15);
}
.ps-logo-card .ps-card-head {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 6px;
}
.ps-logo-card .ps-badge {
  width: 30px; height: 30px;
  border-radius: 8px;
  background: #8ec640;
  display: flex; align-items: center; justify-content: center;
  flex: none;
}
.ps-logo-card .ps-badge svg { width: 16px; height: 16px; fill: #fff; }
.ps-logo-card .ps-card-title {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.2px;
}
.ps-logo-card .ps-card-sub {
  font-size: 13px;
  color: #6b7280;
  margin: 2px 0 14px;
  padding-right: 70px;
  line-height: 1.5;
}
.ps-logo-card.is-yes .ps-card-sub {
  padding-right: 260px;
}
.ps-logo-card .ps-card-sub b { color: #8ec640; }
.ps-logo-card .ps-top-row {
  display: grid;
  grid-template-columns: 1fr auto;
  column-gap: 16px;
  align-items: center;
  margin-bottom: 12px;
}
.ps-logo-card .ps-top-left {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10px;
  align-self: center;
}
.ps-logo-card.is-yes .ps-top-row {
  position: relative;
  padding-right: 260px;
  align-items: start;
}
.ps-logo-card.is-yes .ps-top-left {
  align-self: start;
}
.ps-logo-card .ps-right-logos {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-end;
  justify-self: end;
}
.ps-logo-card.is-yes .ps-right-logos {
  position: absolute;
  top: 0;
  right: 0;
}
.ps-logo-card .ps-logo-image {
  display: block;
  width: 220px;
  max-width: 45vw;
  height: auto;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 10px;
  box-shadow: 0 1px 10px rgba(0, 0, 0, 0.06);
}
.ps-logo-card .ps-logo-image--below {
  display: block;
}
.ps-logo-card .ps-toggle {
  display: inline-flex;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid #8ec640;
  font-size: 13px;
  font-weight: 600;
}
.ps-logo-card .ps-toggle label {
  border: none;
  background: #fff;
  color: #1a1a1a;
  padding: 6px 18px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  margin: 0;
  transition: background 0.15s, color 0.15s;
}
.ps-logo-card .ps-toggle input[type="radio"] { display: none; }
.ps-logo-card .ps-toggle input[type="radio"]:checked + label {
  background: #8ec640;
  color: #fff;
}
.ps-logo-card .ps-real-logo {
  max-height: 40px;
  width: auto;
  display: block;
  margin-left: auto;
}
.ps-logo-card .ps-free-tag {
  font-size: 11px;
  font-weight: 700;
  color: #8ec640;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  margin-bottom: 6px;
}
.ps-logo-card .ps-save-line {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 700;
  color: #101820;
  background: #eceef0;
  padding: 4px 10px;
  border-radius: 20px;
  margin-bottom: 10px;
}
.ps-logo-card .ps-save-line svg { width: 12px; height: 12px; fill: #101820; }
.ps-logo-card .ps-position-holder {
  margin-top: 14px;
}
.ps-logo-card .ps-controls-left .product-form__input {
  margin: 0 0 14px;
}
.ps-logo-card .ps-controls-left .product-form__input:last-child {
  margin-bottom: 0;
}
.ps-logo-card .ps-controls-left .form__label {
  margin-bottom: 6px;
  display: block;
}
.ps-logo-card .ps-preview {
  display: none;
  margin-top: 12px;
  align-items: center;
  gap: 10px;
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12.5px;
  color: #6b7280;
}
.ps-logo-card .ps-preview.show { display: flex; }
.ps-logo-card .ps-preview b { color: #1a1a1a; }

.ps-logo-card .ps-controls-row {
  display: flex;
  gap: 18px;
  align-items: flex-start;
}
.ps-logo-card .ps-controls-left {
  flex: 1;
  min-width: 0;
}
.ps-logo-card .ps-controls-right {
  width: 240px;
  flex: none;
}
.ps-logo-card .ps-image-preview {
  display: none;
  width: 100%;
  aspect-ratio: 1 / 1;
  border: 1px dashed #c5d2a9;
  border-radius: 10px;
  background: #f8fcee;
  overflow: hidden;
  align-items: center;
  justify-content: center;
}
.ps-logo-card .ps-image-preview.show { display: flex; }
.ps-logo-card .ps-image-preview img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}

@media (max-width: 640px) {
  .ps-logo-card .ps-card-sub {
    padding-right: 0;
  }
  .ps-logo-card .ps-top-row {
    grid-template-columns: 1fr;
  }
  .ps-logo-card .ps-right-logos {
    position: static;
    width: 100%;
    align-items: center;
    margin-top: 12px;
  }
  .ps-logo-card.is-yes .ps-top-row {
    padding-right: 0;
  }
  .ps-logo-card .ps-position-holder {
    margin-top: 12px;
  }
  .ps-logo-card .ps-logo-image {
    width: min(320px, 100%);
    max-width: 100%;
  }
  .ps-logo-card .ps-controls-row {
    flex-direction: column;
  }
  .ps-logo-card .ps-controls-right {
    width: 100%;
  }
}
</style>

<div class="ps-logo-card{% if already_yes == 'yes' %} is-yes{% endif %}" id="{{ prefix }}_ps_logo_card">
  <div class="ps-ribbon">SAVE 5%</div>

  <div class="ps-card-head">
    <div class="ps-badge">
      <svg viewBox="0 0 24 24"><path d="M12 2 3 7v6c0 5 4 8.5 9 9 5-.5 9-4 9-9V7l-9-5z"/></svg>
    </div>
    <div class="ps-card-title">Add ProSoccer Logo</div>
  </div>

  <div class="ps-card-sub">
    This item will feature the <b>ProSoccer</b> logo — always included, <b>free</b>, and it unlocks a <b>5% discount</b> on this product.
  </div>

  <div class="ps-top-row">
    <div class="ps-top-left">
      <div class="ps-toggle">
        <input type="radio" name="properties[PS Custom Logo]" id="{{ prefix }}_ps_logo_no" value="no"
          {% unless already_yes == 'yes' %}checked{% endunless %}>
        <label for="{{ prefix }}_ps_logo_no">No</label>
        <input type="radio" name="properties[PS Custom Logo]" id="{{ prefix }}_ps_logo_yes" value="yes"
          {% if already_yes == 'yes' %}checked{% endif %}>
        <label for="{{ prefix }}_ps_logo_yes">Yes</label>
      </div>

      <div class="ps-free-tag">Always free to add</div>

      <div class="ps-save-line">
        <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5 1.4-1.4L9 14.2 18.6 4.6z"/></svg>
        5% off applied at checkout
      </div>
    </div>
    <div class="ps-right-logos">
      <img class="ps-logo-image ps-logo-image--above" id="{{ prefix }}_ps_logo_above" src="{{ 'ps_above.png' | asset_url }}" alt="Ps logo Above" width="200">
      <img class="ps-logo-image ps-logo-image--below" id="{{ prefix }}_ps_logo_below" src="{{ 'ps_below.png' | asset_url }}" alt="Ps logo below" width="200">
    </div>
  </div>

  <div class="{{ position_holder_class }} ps-position-holder" style="display:none;">
    <div class="ps-controls-row">
      <div class="ps-controls-left">
        <!-- Jersey Side -->
        <div class="product-form__input product-form__input--dropdown mb-3">
          <label class="form__label" for="{{ prefix }}_ps_jersey_side"><strong>Placement:</strong></label>
          <div class="select">
            <select id="{{ prefix }}_ps_jersey_side" class="select__select" name="properties[PS Jersey Side]">
              <option value="Front Side">Front Side</option>
              <option value="Back Side">Back Side</option>
            </select>
            {% render 'icon-caret' %}
          </div>
        </div>

        <!-- Position Of Logo -->
        <div class="product-form__input product-form__input--dropdown mb-3">
          <label class="form__label" for="{{ prefix }}_ps_logo_position"><strong>Position Of Logo:</strong></label>
          <div class="select">
            <select id="{{ prefix }}_ps_logo_position" class="select__select" name="properties[PS Logo Position]">
              <option value="Chest">Chest</option>
              <option value="Crest">Crest</option>
            </select>
            {% render 'icon-caret' %}
          </div>
        </div>

        <!-- Color & Shape -->
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="{{ prefix }}_ps_logo_color_shape"><strong>Color & Shape:</strong></label>
          <div class="select">
            <select id="{{ prefix }}_ps_logo_color_shape" class="select__select" name="properties[PS Logo Color Shape]">
              <option value="Rectangular Coloured">Rectangular Coloured</option>
              <option value="Rectangular Black">Rectangular Black</option>
              <option value="Square Coloured">Square Coloured</option>
              <option value="Square Black">Square Black</option>
            </select>
            {% render 'icon-caret' %}
          </div>
        </div>
      </div>

      <div class="ps-controls-right">
        <div class="ps-image-preview {% if already_yes == 'yes' %}show{% endif %}" id="{{ prefix }}_ps_image_preview">
          <img id="{{ prefix }}_ps_preview_img" src="{{ 'front_chest.png' | asset_url }}" alt="Logo Position Preview">
        </div>
      </div>
    </div>
  </div>

  <div class="ps-preview {% if already_yes == 'yes' %}show{% endif %}" id="{{ prefix }}_ps_preview">
    <b>ProSoccer logo added.</b>&nbsp;Your 5% discount will show at checkout.
  </div>
</div>

<script>
(function() {
  const prefix = '{{ prefix }}';
  const jerseySideSelect = document.getElementById(prefix + '_ps_jersey_side');
  const logoPositionSelect = document.getElementById(prefix + '_ps_logo_position');
  const previewImg = document.getElementById(prefix + '_ps_preview_img');
  const imagePreview = document.getElementById(prefix + '_ps_image_preview');
  const cardEl = document.getElementById(prefix + '_ps_logo_card');
  const logoYesRadio = document.getElementById(prefix + '_ps_logo_yes');
  const logoNoRadio = document.getElementById(prefix + '_ps_logo_no');

  const imageMap = {
    'Front Side': {
      'Chest': "{{ 'front_chest.png' | asset_url }}",
      'Crest': "{{ 'front_crest.png' | asset_url }}"
    },
    'Back Side': {
      'Top': "{{ 'back_top.png' | asset_url }}",
      'Bottom': "{{ 'back_bottom.png' | asset_url }}"
    }
  };

  function updatePreviewImage() {
    if (!jerseySideSelect || !logoPositionSelect || !previewImg) return;
    const side = jerseySideSelect.value;
    const position = logoPositionSelect.value;
    const imgSrc = imageMap[side] && imageMap[side][position];
    if (imgSrc) {
      previewImg.src = imgSrc;
    }
  }

  function updatePositionOptions() {
    const side = jerseySideSelect.value;
    logoPositionSelect.innerHTML = '';

    if (side === 'Front Side') {
      const optionChest = document.createElement('option');
      optionChest.value = 'Chest';
      optionChest.textContent = 'Chest';
      logoPositionSelect.appendChild(optionChest);

      const optionCrest = document.createElement('option');
      optionCrest.value = 'Crest';
      optionCrest.textContent = 'Crest';
      logoPositionSelect.appendChild(optionCrest);
    } else {
      const optionTop = document.createElement('option');
      optionTop.value = 'Top';
      optionTop.textContent = 'Top';
      logoPositionSelect.appendChild(optionTop);

      const optionBottom = document.createElement('option');
      optionBottom.value = 'Bottom';
      optionBottom.textContent = 'Bottom';
      logoPositionSelect.appendChild(optionBottom);
    }

    updatePreviewImage();
  }

  function handleLogoToggle() {
    const isYes = logoYesRadio && logoYesRadio.checked;
    if (cardEl) {
      cardEl.classList.toggle('is-yes', !!isYes);
    }
    if (isYes) {
      if (imagePreview) imagePreview.classList.add('show');
    } else {
      if (imagePreview) imagePreview.classList.remove('show');
    }
  }

  if (jerseySideSelect && logoPositionSelect) {
    jerseySideSelect.addEventListener('change', updatePositionOptions);
    logoPositionSelect.addEventListener('change', updatePreviewImage);
    updatePositionOptions(); // Initialize on load
  }

  if (logoYesRadio && logoNoRadio) {
    logoYesRadio.addEventListener('change', handleLogoToggle);
    logoNoRadio.addEventListener('change', handleLogoToggle);
    handleLogoToggle(); // Initialize on load
  }
})();
</script>
